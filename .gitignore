# Virtual environment
blockvenv/
venv/
env/

# Raw data files (too large for GitHub, 40-50MB each)
data/raw/

# Python cache
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Models (ignore large binary files, allow lightweight JSON model configs)
models/*
!models/*.json

# Local DB files
*.db
*.sqlite
